*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    background:#f5f7fb;
}

header{
    background:white;
    padding:20px 50px;
    border-bottom:1px solid #ddd;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

header h1{
    font-size:28px;
}

header p{
    color:#666;
}

.back-btn{
    text-decoration:none;
    border:1px solid #ddd;
    padding:10px 18px;
    border-radius:8px;
    color:black;
    background:white;
}

.container{
    width:90%;
    max-width:1100px;
    margin:25px auto;
}

.card{
    background:white;
    border:1px solid #ddd;
    border-radius:12px;
    padding:20px;
    margin-bottom:20px;
}

.test-header{
    display:flex;
    align-items:center;
    gap:15px;
}

.icon{
    width:60px;
    height:60px;
    background:#3b82f6;
    color:white;
    border-radius:10px;
    display:flex;
    justify-content:center;
    align-items:center;
    font-size:28px;
}

.details{
    display:flex;
    justify-content:space-between;
    margin-top:25px;
}

.details span{
    display:block;
    color:#666;
    margin-bottom:5px;
}

.notice{
    background:#fff7ed;
    border:1px solid #fdba74;
    border-radius:10px;
    padding:20px;
    margin-bottom:20px;
}

.notice h3{
    color:#ea580c;
    margin-bottom:10px;
}

.notice p{
    color:#9a3412;
}

.subtitle{
    color:#666;
    margin-top:5px;
    margin-bottom:15px;
}

.rules{
    padding-left:20px;
}

.rules li{
    margin-bottom:12px;
}

.equipment-btn{
    width:100%;
    padding:12px;
    border:1px solid #ddd;
    border-radius:8px;
    background:white;
    cursor:pointer;
}

.checkbox{
    display:flex;
    gap:10px;
    line-height:1.7;
}

.button-group{
    margin-top:20px;
    display:flex;
    gap:15px;
}

.cancel-btn{
    width:220px;
    padding:12px;
    border:1px solid #ddd;
    background:white;
    border-radius:8px;
    cursor:pointer;
}

.start-btn{
    width:220px;
    padding:12px;
    border:none;
    background:#7ea4ff;
    color:white;
    border-radius:8px;
    cursor:pointer;
}

.start-btn:hover{
    background:#2563eb;
}